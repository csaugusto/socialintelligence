# ─── Datafactory WebSocket ──────────────────────────────────────────────────
# URL del WebSocket de Datafactory (ejemplo: wss://feeds.datafactory.com/live)
DATAFACTORY_WS_URL=

# Token de autenticación de Datafactory
DATAFACTORY_TOKEN=

# ─── Nombres de atributos en el XML de Datafactory ──────────────────────────
# Ajustar si los nombres de atributos difieren del esquema por defecto
# Tipo de evento gol (valor del atributo type en <Event>)
XML_GOAL_TYPE=goal

# ─── Instagram Graph API ────────────────────────────────────────────────────
# Token de larga duración (ver README para instrucciones de obtención)
INSTAGRAM_ACCESS_TOKEN=

# ID de usuario de Instagram Business/Creator
INSTAGRAM_USER_ID=

# ─── Supabase Storage (alojamiento de imágenes generadas) ───────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Nombre del bucket (debe ser público)
SUPABASE_BUCKET=worldcup-goals

# ─── Opcionales ─────────────────────────────────────────────────────────────
# Espera mínima entre posts de Instagram (ms) para evitar rate limits
POST_COOLDOWN_MS=5000

# Prefijo del caption de Instagram
CAPTION_PREFIX=#Mundial2026 #FIFAWorldCup
